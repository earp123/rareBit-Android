<?xml version="1.0" encoding="utf-8"?>
<com.example.rarebit.ui.GlowCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_pre_connect"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp">

            <!-- Device name -->
            <TextView
                android:id="@+id/deviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="13dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/deviceTypeIcon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge row (connected state only) -->
            <LinearLayout
                android:id="@+id/badgeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="13dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/rssiBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deviceName">

                <TextView
                    android:id="@+id/badgeConnected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/label_connected"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/badgeUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_update"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/label_update"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Device type icon (connected state only) -->
            <ImageView
                android:id="@+id/deviceTypeIcon"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/ic_device_unknown"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/rssiBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Spacer pushes card height in pre-connect when badge row is gone -->
            <Space
                android:id="@+id/bottomSpacer"
                android:layout_width="0dp"
                android:layout_height="13dp"
                app:layout_constraintBottom_toTopOf="@id/rssiBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deviceName" />

            <!-- RSSI progress bar — pre-connect, inset from all edges -->
            <ProgressBar
                android:id="@+id/rssiBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="9dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF1A1A1A"
                android:progressBackgroundTint="#FFE0E0E0"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</com.example.rarebit.ui.GlowCardView>
